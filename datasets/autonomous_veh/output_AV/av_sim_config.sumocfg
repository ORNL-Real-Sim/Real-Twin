<?xml version="1.0" ?>
<configuration>
    <input>
        <net-file value="chatt3.net.xml"/>
        <route-files value="chatt3.rou.xml"/>
        <additional-files value="detector.add.xml"/>
    </input>
    <output>
        <full-output value="AV_Sim_Full_Output.xml"/>
        <amitran-output value="AV_Sim_Amitran_Output.xml"/>
        <vehroute-output value="AV_Sim_VehRoute_Output.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="3600"/>
        <step-length value="0.1"/>
    </time>
    <gui_only>
        <start value="t"/>
    </gui_only>
    <report>
        <no-warnings value="true"/>
        <no-step-log value="true"/>
    </report>
</configuration>
