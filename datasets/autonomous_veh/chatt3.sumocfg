<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/duarouterConfiguration.xsd">

    <input>
        <net-file value="chatt3.net.xml" />
        <route-files value="chatt3.rou.xml" />
		<additional-files value="abcde.xml" />
    </input>

    <output>
        <full-output value="av_full-output.xml" />
	    <amitran-output value="av_amitran-output.xml" />
	    <vehroute-output value="av_veh_route_output.xml" />
    </output>

    <time>
        <begin value="54000" />
        <end value="64800" />
        <step-length value="0.1" />
    </time>

	<gui_only>
	    <start value="t" />
    </gui_only>

    <report>
        <no-warnings value="true" />
        <no-step-log value="true" />
    </report>

</configuration>